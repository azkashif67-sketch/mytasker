# Minute — environment variables (see brief §4).
# Copy to .env.local and fill in from your Supabase project settings.
# Only these two exist. NEVER add the service-role key here — it must never
# reach the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: used only by `npm run gen:types` to regenerate lib/types.ts.
# Not shipped to the browser.
SUPABASE_PROJECT_ID=
